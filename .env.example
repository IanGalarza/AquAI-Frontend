#
# URL del backend.
#
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

#
# Espera máxima al enviar un mensaje, en ms; debe superar el timeout del backend.
#
NEXT_PUBLIC_CONVERSATION_TIMEOUT_MS=1620000

#
# Tamaño máximo de carga; coincide con TABULAR_MAX_UPLOAD_BYTES del backend.
#
NEXT_PUBLIC_MAX_UPLOAD_BYTES=10485760

#
# Tamaño máximo de PDF y DOCX; coincide con DOCUMENT_MAX_UPLOAD_BYTES del backend.
#
NEXT_PUBLIC_MAX_DOCUMENT_UPLOAD_BYTES=67108864

#
# Duración mínima del indicador de carga del catálogo, en ms (0 lo desactiva).
#
NEXT_PUBLIC_MINIMUM_CATALOG_LOADING_MS=600
