NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# Espera del POST conversacional en ms. Debe superar CONVERSATIONS_GENERATION_TIMEOUT_SECONDS
# del backend (1.500 segundos por defecto); no afecta la carga de fuentes ni los GET.
NEXT_PUBLIC_CONVERSATION_TIMEOUT_MS=1620000
# Debe coincidir con TABULAR_MAX_UPLOAD_BYTES del backend (10 MiB por defecto).
NEXT_PUBLIC_MAX_UPLOAD_BYTES=10485760
# Duración mínima del indicador de carga del catálogo, en ms (0 lo desactiva).
NEXT_PUBLIC_MINIMUM_CATALOG_LOADING_MS=600
